<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement style="flex-grow: 1; background-color: rgba(202, 202, 202, 0.502); border-top-left-radius: 128px; border-top-right-radius: 128px; border-bottom-right-radius: 128px; border-bottom-left-radius: 128px;">
        <ui:VisualElement style="flex-grow: 1; margin-top: 45px; margin-right: 45px; margin-bottom: 45px; margin-left: 45px;">
            <ui:VisualElement style="flex-grow: 0; align-self: auto; align-content: auto; justify-content: center; background-color: rgb(89, 89, 89); border-top-left-radius: 96px; border-top-right-radius: 96px; border-bottom-right-radius: 96px; border-bottom-left-radius: 96px; width: auto; height: 15%; flex-shrink: 0;">
                <ui:Label text="Title" name="Title" style="font-size: 14px; -unity-text-auto-size: best-fit 10px 100px; -unity-text-align: middle-center; align-self: auto; align-content: auto; white-space: normal;"/>
            </ui:VisualElement>
            <ui:VisualElement style="flex-grow: 1; padding-top: 29px; padding-right: 29px; padding-bottom: 29px; padding-left: 29px;">
                <ui:Label text="&#x9;Lorem ipsum dolor sit amet, consectetur adipiscing elit. Cras tristique at ante at pulvinar. Integer interdum mauris nec faucibus porttitor. Cras rhoncus nunc sed est dignissim vulputate. Fusce ac congue ante, ut molestie lacus. Sed nec augue ipsum. Etiam vulputate placerat lectus, sed posuere nibh vulputate ultricies. Sed laoreet, nibh nec hendrerit bibendum, dui massa semper lectus, id finibus nisi massa sit amet est. Nunc imperdiet eros at justo venenatis consequat non vitae eros. Pellentesque ac purus mi. Fusce in magna vulputate magna hendrerit facilisis ut in libero.&#10;&#10;&#x9;Aenean tempus in risus non facilisis. Praesent tristique facilisis dui, ut sodales purus vestibulum a. Sed venenatis pellentesque egestas. Integer ullamcorper tellus a eros tristique, ac eleifend mi malesuada. Proin lobortis dictum sapien consectetur varius. Ut lorem tellus, commodo vel urna id, ultricies suscipit sem. Suspendisse potenti. Donec sit amet volutpat nunc." name="Info" style="-unity-text-auto-size: best-fit 10px 100px; white-space: pre-wrap; flex-shrink: 1; flex-grow: 1;"/>
            </ui:VisualElement>
            <ui:VisualElement style="flex-grow: 0; flex-shrink: 0; height: 10%;">
                <ui:Button text="Continue" name="Continue_Button" style="-unity-text-auto-size: best-fit 10px 100px; flex-shrink: 1; flex-grow: 1; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; border-top-left-radius: 52px; border-top-right-radius: 52px; border-bottom-right-radius: 52px; border-bottom-left-radius: 52px;"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
